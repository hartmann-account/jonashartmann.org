---
/*
 * Seitenkopf. Gleiche Anatomie wie eine Sektion, eine Stufe groesser:
 * Eyebrow mit dem uebergeordneten Bereich, Titel, Lead in Lesebreite.
 */
interface Props {
  /** Bereich, in dem die Seite haengt, z. B. "Work". */
  eyebrow: string;
  title: string;
  lead?: string;
  /** Stichwortzeile unter dem Titel (Qualifizierer, kursiv gesetzt). */
  kicker?: string;
}
const { eyebrow, title, lead, kicker } = Astro.props;
---
<header class="page-header">
  <div class="wrap grid">
    <span class="eyebrow zone-meta">{eyebrow}</span>
    <div class="zone-main">
      <h1 class="page-title">{title}</h1>
      {kicker && <p class="page-kicker">{kicker}</p>}
      {lead && <p class="page-lead">{lead}</p>}
      <slot />
    </div>
  </div>
</header>

<style>
  .page-kicker {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--display-xs);
    line-height: 1.3;
    color: var(--fg-secondary);
    max-width: var(--measure);
    margin-block-end: var(--space-5);
  }
</style>
