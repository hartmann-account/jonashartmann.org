---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import research from "../../content/research.json";
const p = research.publications;
const orcidUrl = `https://orcid.org/${p.orcid}`;
---
<Base title={p.title} description={p.intro} path="/research/publications">
  <PageHeader eyebrow="Research" title={p.title} lead={p.intro}>
    <a class="orcid-badge" href={orcidUrl} rel="me noopener" style="margin-block-start: var(--space-5)">
      <svg viewBox="0 0 256 256" aria-hidden="true"><path fill="#A6CE39" d="M256 128c0 70.7-57.3 128-128 128S0 198.7 0 128 57.3 0 128 0s128 57.3 128 128z"/><path fill="#fff" d="M86.3 186.2H70.9V79.1h15.4v107.1zM108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-21.5 53.6-56.8 53.6h-41.8V79.1zm15.4 93.3h24.5c34.9 0 42.9-26.5 42.9-39.7 0-21.5-13.7-39.7-43.7-39.7h-23.7v79.4zM88.7 56.8c0 5.5-4.5 10.1-10.1 10.1s-10.1-4.6-10.1-10.1c0-5.6 4.5-10.1 10.1-10.1s10.1 4.6 10.1 10.1z"/></svg>
      <span>ORCID {p.orcid}</span>
    </a>
  </PageHeader>

  <Section index="01" title="Works" note="Loaded live from the ORCID record.">
    <div class="wrap">
      {/*
        Die Liste kommt live von der ORCID Public API (CORS ist freigegeben).
        Die Seite ist statisch, deshalb laeuft der Abruf im Browser; ohne
        JavaScript oder bei Ausfall bleibt der Link auf das Profil.
      */}
      <ol class="pub-list" id="pubs" data-orcid={p.orcid} aria-live="polite">
        <li class="text-tertiary" id="pubs-status">Loading from ORCID …</li>
      </ol>
      <noscript>
        <p class="text-tertiary text-sm" style="margin-block-start: var(--space-4)">
          The publication list is loaded from ORCID and needs JavaScript.
          See the full record at <a href={orcidUrl}>orcid.org/{p.orcid}</a>.
        </p>
      </noscript>
    </div>
  </Section>
</Base>

<script>
  const list = document.getElementById("pubs") as HTMLOListElement | null;
  const status = document.getElementById("pubs-status");
  const id = list?.dataset.orcid;

  const typeLabel: Record<string, string> = {
    "journal-article": "Journal article",
    "working-paper": "Working paper",
    "dissertation-thesis": "Thesis",
    "book": "Book",
    "book-chapter": "Book chapter",
    "conference-paper": "Conference paper",
    "report": "Report",
    "preprint": "Preprint",
    "other": "Other",
  };

  /* Nur http(s)-Links duerfen in ein href; ORCID-URL-Felder sind Freitext. */
  const safeUrl = (u?: string) => {
    if (!u) return undefined;
    try {
      const parsed = new URL(u);
      return parsed.protocol === "https:" || parsed.protocol === "http:" ? u : undefined;
    } catch {
      return undefined;
    }
  };

  async function load() {
    if (!list || !id) return;
    const fallback = () => {
      if (status) {
        status.innerHTML = `The list could not be loaded right now. See the full record at <a href="https://orcid.org/${id}">orcid.org/${id}</a>.`;
      }
    };
    try {
      const res = await fetch(`https://pub.orcid.org/v3.0/${id}/works`, {
        headers: { Accept: "application/json" },
        signal: AbortSignal.timeout(8000),
      });
      if (!res.ok) return fallback();
      const data = await res.json();
      const works = (data.group ?? [])
        .map((g: any) => g["work-summary"]?.[0])
        .filter(Boolean)
        .map((s: any) => {
          const ids = s["external-ids"]?.["external-id"] ?? [];
          const doiId = ids.find((i: any) => i["external-id-type"] === "doi");
          const doi: string | undefined = doiId?.["external-id-value"];
          // DOIs duerfen URL-Sonderzeichen enthalten: segmentweise kodieren.
          const doiHref = doi ? `https://doi.org/${doi.split("/").map(encodeURIComponent).join("/")}` : undefined;
          return {
            title: s.title?.title?.value as string | undefined,
            type: typeLabel[s.type] ?? s.type ?? "",
            year: s["publication-date"]?.year?.value as string | undefined,
            journal: s["journal-title"]?.value as string | undefined,
            href: safeUrl(s.url?.value) ?? safeUrl(doiId?.["external-id-url"]?.value) ?? doiHref,
            doi,
          };
        })
        .filter((w: any) => w.title)
        .sort((a: any, b: any) => Number(b.year ?? 0) - Number(a.year ?? 0));

      list.innerHTML = "";
      if (works.length === 0) {
        list.innerHTML = `<li class="text-tertiary">No public works listed on ORCID yet.</li>`;
        return;
      }
      for (const w of works) {
        const li = document.createElement("li");
        const title = document.createElement("p");
        title.className = "pub-title";
        if (w.href) {
          const a = document.createElement("a");
          a.href = w.href;
          a.rel = "noopener";
          a.textContent = w.title;
          title.appendChild(a);
        } else {
          title.textContent = w.title;
        }
        li.appendChild(title);
        const meta = document.createElement("p");
        meta.className = "pub-meta";
        meta.textContent = [w.type, w.journal, w.year].filter(Boolean).join(" · ") + (w.doi ? ` · DOI ${w.doi}` : "");
        li.appendChild(meta);
        list.appendChild(li);
      }
    } catch {
      fallback();
    }
  }
  load();
</script>
