---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import V from "../../components/V.astro";
import research from "../../content/research.json";
const o = research.familyOffices;
---
<Base title={o.title} description={o.text.value} path="/research/family-offices">
  <PageHeader eyebrow="Research" title={o.title} />

  <Section index="01" title="Doctoral research">
    <div class="wrap grid">
      <p class="zone-main text-secondary" style="line-height: var(--leading-relaxed)">
        <V f={o.text} />
      </p>
    </div>
  </Section>
</Base>
