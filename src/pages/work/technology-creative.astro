---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import V from "../../components/V.astro";
import work from "../../content/work.json";
const t = work.technology;
---
<Base title={t.title} description={t.intro} path="/work/technology-creative">
  <PageHeader eyebrow="Work" title={t.title} lead={t.intro} />

  <Section index="01" title="Areas">
    <div class="wrap">
      <ul class="tag-list">
        {t.areas.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </Section>

  <Section index="02" title="Music">
    <div class="wrap grid">
      <div class="zone-main stack stack-4">
        <p class="text-secondary">
          Music production and DJing are part of where this started, not a footnote to it.
        </p>
        <a class="cta" href={t.music.href} rel="noopener">
          {t.music.label} <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="section-note zone-side"><V f={t.screenshots} /></p>
    </div>
  </Section>
</Base>
