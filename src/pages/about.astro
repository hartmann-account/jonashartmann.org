---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import V from "../components/V.astro";
import about from "../content/about.json";

const [opening, ...story] = about.story;
const description = story.slice(0, 1).join(" ");
---
<Base title={about.title} description={description} path="/about">
  {/* Portraet in der Marginalie, Story in Lesebreite - gleiche Anatomie wie der Hero. */}
  <header class="page-header">
    <div class="wrap grid">
      <span class="eyebrow zone-meta">About</span>

      <div class="zone-main">
        <h1 class="page-title about-opening">{opening}</h1>
        <div class="prose">
          {story.map((par, i) => (
            <p class:list={{ "is-lead": i === 0 }}>{par}</p>
          ))}
        </div>
      </div>

      <figure class="zone-side">
        <img
          class="about-portrait"
          src={about.portrait.src}
          alt={about.portrait.alt}
          width="512"
          height="512"
          fetchpriority="high"
        />
      </figure>
    </div>
  </header>

  {/* Die Klammer als Zeitleiste, mit denselben vier Stufen wie auf der Startseite. */}
  <Section index="01" title={about.timeline.title} note="The same four stages, in detail.">
    <div class="wrap">
      <ol class="timeline">
        {about.timeline.stages.map((s) => (
          <li class="grid">
            <div class="zone-meta stack stack-2">
              <span class="stage-num">{s.no}</span>
              <span class="timeline-period"><V f={s.period} /></span>
            </div>
            <div class="zone-main">
              <h3 class="timeline-title">{s.title}</h3>
              <ul class="timeline-details">
                {s.details.map((d) => <li><V f={d} /></li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  {about.images?.length > 0 && (
    <Section index="02" title="Elsewhere">
      <div class="wrap grid about-images">
        {about.images.map((img) => (
          <figure class="figure">
            <img src={img.src} alt={img.alt} loading="lazy" />
            <figcaption><V f={img.caption} /></figcaption>
          </figure>
        ))}
      </div>
    </Section>
  )}
</Base>

<style>
  .about-opening {
    font-size: var(--display-xl);
    max-width: 14ch;
    margin-block-end: var(--space-6);
  }
  .about-portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    filter: grayscale(1) contrast(1.06);
  }
  @media (max-width: 1023px) {
    .about-portrait {
      max-width: 240px;
      aspect-ratio: 1 / 1;
    }
  }
  .about-images {
    row-gap: var(--space-6);
  }
  .about-images .figure {
    grid-column: span 6;
  }
  .about-images .figure img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (max-width: 639px) {
    .about-images .figure {
      grid-column: 1 / -1;
    }
  }
</style>
