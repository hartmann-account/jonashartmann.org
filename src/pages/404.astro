---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
---
<Base title="Page not found" description="This page does not exist." path="/404">
  <PageHeader eyebrow="404" title="Page not found" lead="This page does not exist.">
    <a class="cta" href="/" style="margin-block-start: var(--space-5)">
      Back to the start <span aria-hidden="true">→</span>
    </a>
  </PageHeader>
</Base>
