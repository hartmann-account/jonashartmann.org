---
import "../styles/global.css";
import site from "../content/site.json";

interface Props {
  title: string;
  description: string;
  /** Pfad der Seite fuer canonical und aria-current, z. B. "/work/advisory". */
  path: string;
}
const { title, description, path } = Astro.props;

const siteUrl = site.domain.value.replace(/\/$/, "");
const canonical = `${siteUrl}${path === "/" ? "" : path}`;
const fullTitle = path === "/" ? `${site.name} — ${site.roles.join(" · ")}` : `${title} — ${site.name}`;

/* Oberster Pfadabschnitt bestimmt den aktiven Navigationspunkt. */
const section = "/" + path.split("/")[1];
const cvHref = site.nav.find((n) => n.href === "/cv")?.href ?? "/cv";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/images/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/cormorant-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        {/* Wortmarke: das Initial leicht groesser, wie im Brand Book. */}
        <a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}><span class="initial">J</span>onas <span class="initial">H</span>artmann</a>
        <nav class="nav" aria-label="Main">
          {site.nav.map((item) => (
            <a href={item.href} aria-current={section === item.href ? (path === item.href ? "page" : "true") : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{site.name} · {site.location}</p>
        <ul class="footer-links">
          <li>
            {site.email.verified && site.email.value
              ? <a href={`mailto:${site.email.value}`}>{site.email.value}</a>
              : <span class="unverified" title="To verify: email address">[email]</span>}
          </li>
          <li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>
          <li><a href={cvHref}>Full CV</a></li>
        </ul>
        {/* Bildmarke als stiller Abschluss (Brand Book 5.0) */}
        <span class="footer-mark" aria-hidden="true">H</span>
      </div>
    </footer>
  </body>
</html>
