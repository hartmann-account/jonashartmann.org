---
import "../styles/global.css";
import site from "../content/site.json";

interface Props {
  title: string;
  description: string;
  /** Pfad der Seite, z. B. "/work/advisory". Steuert canonical und aria-current. */
  path: string;
}
const { title, description, path } = Astro.props;

const siteUrl = site.domain.value.replace(/\/$/, "");
const canonical = `${siteUrl}${path === "/" ? "" : path}`;
const fullTitle = path === "/" ? `${site.name} — ${site.roles.join(" · ")}` : `${title} — ${site.name}`;

/* Oberster Pfadabschnitt bestimmt den aktiven Navigationspunkt. */
const section = "/" + path.split("/")[1];
const year = 2026;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#f4f3f0" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/images/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/cormorant-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        {/* Wortmarke: das Initial eine Spur groesser, wie im Brand Book. */}
        <a class="wordmark" href="/" aria-current={path === "/" ? "page" : undefined}>
          <span class="initial">J</span>onas <span class="initial">H</span>artmann
        </a>
        <nav class="site-nav" aria-label="Main">
          {site.nav.map((item) => (
            <a href={item.href} aria-current={section === item.href ? (path === item.href ? "page" : "true") : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap grid">
        <div class="zone-meta">
          <span class="eyebrow">Contact</span>
          <div class="footer-contact">
            {site.email.verified && site.email.value
              ? <a href={`mailto:${site.email.value}`}>{site.email.value}</a>
              : <span class="unverified" title="To verify: email address">[email]</span>}
            <a href={site.linkedin} rel="me noopener">LinkedIn</a>
          </div>
        </div>

        <div class="zone-main">
          <span class="eyebrow">Elsewhere</span>
          <div class="footer-contact">
            <a href="/cv">Full curriculum vitae</a>
            <a href={`https://orcid.org/${site.orcid}`} rel="me noopener">ORCID {site.orcid}</a>
          </div>
        </div>

        {/* Bildmarke als stiller Abschluss (Brand Book 5.0) */}
        <span class="footer-mark zone-side" aria-hidden="true">H</span>

        <div class="footer-baseline">
          <span>{site.name} · {site.location}</span>
          <span>© {year}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
