---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import IndexList from "../../components/IndexList.astro";
import V from "../../components/V.astro";
import research from "../../content/research.json";
const r = research.index;
---
<Base title={r.title} description={r.intro} path="/research">
  <PageHeader eyebrow="Research" title={r.title} lead={r.intro} />

  <Section index="01" title="Education">
    <div class="wrap">
      <ol class="data-table">
        {r.education.map((e) => (
          <li class:list={["data-row", { "is-major": e.weight === "major" }]}>
            <span class="data-org"><V f={e.degree} /></span>
            <span class="data-detail"><V f={e.detail} /></span>
            <span class="data-meta"></span>
          </li>
        ))}
      </ol>
      <p class="text-sm text-tertiary" style="margin-block-start: var(--space-4)">
        <V f={r.educationNote} />
      </p>
    </div>
  </Section>

  <Section index="02" title="Fields">
    <div class="wrap">
      <IndexList items={r.pages} />
    </div>
  </Section>
</Base>
