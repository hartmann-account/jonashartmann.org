---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import V from "../../components/V.astro";
import work from "../../content/work.json";
const a = work.advisory;
const areas = a.areas.split(" · ");
---
<Base title={a.title} description={a.intro} path="/work/advisory">
  <PageHeader eyebrow="Work" title={a.title} kicker={a.kicker} lead={a.intro} />

  {/*
    Stationen absteigend. Die Gewichtung steuert die Modifier-Klasse:
    AlixPartners als groesste Nennung, Praktika eine Stufe kleiner.
  */}
  <Section index="01" title="Positions">
    <div class="wrap">
      <ol class="data-table">
        {a.stations.map((s) => (
          <li class:list={["data-row", { "is-major": s.weight === "major", "is-minor": s.weight === "minor" }]}>
            <span class="data-org">{s.org}</span>
            <span class="data-detail"><V f={s.role} /></span>
            <span class="data-meta"><V f={s.period} /></span>
          </li>
        ))}
      </ol>
      <p class="text-sm text-tertiary" style="margin-block-start: var(--space-4)">
        <V f={a.stationsNote} />
      </p>
    </div>
  </Section>

  <Section index="02" title="Areas">
    <div class="wrap">
      <ul class="tag-list">
        {areas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
  </Section>
</Base>
