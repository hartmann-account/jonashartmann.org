---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import V from "../../components/V.astro";
import work from "../../content/work.json";
const e = work.entrepreneurship;
---
<Base title={e.title} description={e.intro} path="/work/entrepreneurship">
  <PageHeader eyebrow="Work" title={e.title} lead={e.intro} />

  <Section index="01" title="Ventures" note="Descending by relevance.">
    <div class="wrap">
      <ol class="data-table">
        {e.ventures.map((v) => (
          <li class="data-row">
            <span class="data-org">{v.name}</span>
            <span class="data-detail"><V f={v.desc} /></span>
            <span class="data-meta"><V f={v.status} /></span>
          </li>
        ))}
      </ol>
    </div>
  </Section>
</Base>
