---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import V from "../components/V.astro";
import site from "../content/site.json";
import home from "../content/home.json";
import about from "../content/about.json";

const description = `${site.tagline} ${home.hero.intro}`;
const metrics = home.experience.tiles.filter((t) => t.kind === "number");
const capabilities = home.experience.tiles.filter((t) => t.kind === "word");
---
<Base title="Home" description={description} path="/">
  {/*
    Hero: Text in der Hauptspalte, Portraet in der Marginalie. Damit steht
    die rechte Rasterzone nicht leer, und die Bildsprache des Brand Books
    (Schwarz-Weiss, harte Kante) ist von der ersten Zeile an praesent.
  */}
  <section class="hero">
    <div class="wrap grid">
      <div class="zone-meta">
        <span class="eyebrow">Zug, Switzerland</span>
      </div>

      <div class="zone-main">
        <p class="hero-name">{site.name}</p>
        <p class="hero-roles">{site.roles.join(" · ")}</p>
        <h1 class="hero-claim">{site.tagline}</h1>
        <p class="hero-intro">{home.hero.intro}</p>
        <a class="cta" href={home.hero.cta.href}>
          {home.hero.cta.label} <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="hero-figure">
        <img
          class="hero-portrait"
          src={about.portrait.src}
          alt={about.portrait.alt}
          width="512"
          height="640"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  {/* 01 — Definition: was Jonas ist. */}
  <Section index="01" title="Four roles" note="Each links to its own page.">
    <div class="wrap">
      <ul class="roles">
        {home.roles.map((r, i) => (
          <li>
            <a href={r.href}>
              <span class="role-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="role-title">{r.title}</span>
              <span class="role-text">{r.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  {/* 02 — Herkunft: wie es dazu kam. Die einzige narrative Strecke. */}
  <Section index="02" title={home.decade.title} note={home.decade.claim}>
    <div class="wrap">
      <p class="band" aria-label={home.decade.band.join(", ")}>
        {home.decade.band.map((word, i) => (
          <>
            <span>{word}</span>
            {i < home.decade.band.length - 1 && <span class="band-arrow" aria-hidden="true">→</span>}
          </>
        ))}
      </p>
    </div>

    <div class="wrap">
      <ol class="stages" data-stages>
        {home.decade.stages.map((s) => (
          <li class="stage grid" data-stage>
            <div class="stage-meta zone-meta">
              <span class="stage-num">{s.no}</span>
              <span class="stage-period"><V f={s.period} /></span>
            </div>
            <div class="zone-main">
              <h3 class="stage-title">{s.title}</h3>
              <p class="stage-text">{s.text}</p>
              <ul class="stage-proof">
                {s.proof.map((p) => (
                  <li class:list={{ "is-major": (p as { major?: boolean }).major }}><V f={p} /></li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>

      <div class="grid stages-outro">
        <p class="stages-backlink zone-main">{home.decade.backlink}</p>
      </div>
    </div>
  </Section>

  {/* 03 — Beweis: Kennzahlen zuerst, Begriffe geordnet darunter. */}
  <Section index="03" title={home.experience.title}>
    <div class="wrap">
      <ul class="metrics">
        {metrics.map((t) => (
          <li class="metric">
            <span class="metric-value"><V f={t} /></span>
            <span class="metric-label">{t.label}</span>
          </li>
        ))}
      </ul>

      <dl class="capabilities">
        {capabilities.map((t) => (
          <div class="capability">
            <dt><V f={t} /></dt>
            <dd>{t.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>
</Base>

<style>
  /*
   * Der Hero teilt das Raster anders auf als die uebrigen Sektionen: die
   * Textspalte ist breiter, damit der Claim in drei Zeilen laeuft, und das
   * Portraet bekommt vier statt drei Spalten.
   */
  .hero .zone-main {
    grid-column: 3 / span 6;
  }
  .hero-figure {
    grid-column: 9 / span 4;
  }
  @media (max-width: 1023px) {
    .hero .zone-main {
      grid-column: 4 / span 9;
    }
    .hero-figure {
      grid-column: 4 / span 9;
    }
  }
  @media (max-width: 639px) {
    .hero .zone-main,
    .hero-figure {
      grid-column: 1 / -1;
    }
  }

  /* Der Rueckverweis schliesst die Strecke ab und braucht Luft davor. */
  .stages-outro {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--border);
  }
</style>

<script>
  /*
   * Die einzige Bewegung der Seite: beim Scrollen durch die Klammer faerbt
   * sich die Nummer der Stufe, die gerade im Lesefeld steht. Ohne
   * JavaScript oder bei prefers-reduced-motion bleiben alle Nummern neutral
   * - die Seite funktioniert unveraendert.
   */
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const stages = Array.from(document.querySelectorAll<HTMLElement>("[data-stage]"));

  if (stages.length && !reduced && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle("is-active", entry.isIntersecting);
        }
      },
      { rootMargin: "-30% 0px -50% 0px", threshold: 0 }
    );
    stages.forEach((s) => io.observe(s));
  }
</script>
