# Header fuer den Workers-Assets-Layer. Schriften und Bilder aendern sich
# nur mit neuem Dateinamen - ein Jahr Cache ist sicher. HTML kurz halten.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=604800
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
